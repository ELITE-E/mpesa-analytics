[importlinter]
root_packages =
    mpesa_core
    synth
include_external_packages = true

[importlinter:contract:core-external]
name = Core has no forbidden external dependencies
type = forbidden
source_modules =
    mpesa_core
forbidden_modules =
    fastapi
    sqlalchemy
    requests
    httpx
    urllib3
    pydantic
    streamlit
    pdfplumber
    pypdf

[importlinter:contract:analytics-isolation]
name = Analytics does not reach the bridge or raw rows
type = forbidden
source_modules =
    mpesa_core.analytics
forbidden_modules =
    mpesa_core.bridge
    mpesa_core.rows

[importlinter:contract:contracts-no-pandas]
name = Contracts are types only and do not load pandas
type = forbidden
source_modules =
    mpesa_core.contracts
forbidden_modules =
    pandas

[importlinter:contract:synth-independent]
name = Synthetic generator and ledger stay independent of the core
type = forbidden
source_modules =
    synth
forbidden_modules =
    mpesa_core
