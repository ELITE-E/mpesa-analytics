[importlinter]
root_packages =
    mpesa_core
    synth
include_external_packages = true

[importlinter:contract:core-external]
name = Core has no forbidden external dependencies
type = forbidden
source_modules =
    mpesa_core
forbidden_modules =
    fastapi
    sqlalchemy
    requests
    httpx
    urllib3
    pydantic
    streamlit
    pdfplumber
    pypdf

[importlinter:contract:analysis-isolation]
name = Analysis does not reach the bridge or raw rows
type = forbidden
source_modules =
    mpesa_core.analysis
forbidden_modules =
    mpesa_core.bridge
    mpesa_core.extraction.rows

[importlinter:contract:pandas-only-in-analysis]
name = pandas is used only inside analysis (ADR 0006)
type = forbidden
source_modules =
    mpesa_core.extraction
    mpesa_core.cleaning
    mpesa_core.classification
    mpesa_core.reconciliation
    mpesa_core.contracts
    mpesa_core.errors
    mpesa_core.pipeline
    mpesa_core.bridge
    mpesa_core.types
forbidden_modules =
    pandas
# The pipeline calls analysis, which uses pandas; only a direct import is forbidden.
allow_indirect_imports = true

[importlinter:contract:contracts-no-pandas]
name = Contracts are types only and do not load pandas
type = forbidden
source_modules =
    mpesa_core.contracts
forbidden_modules =
    pandas

[importlinter:contract:synth-independent]
name = Synthetic generator and ledger stay independent of the core
type = forbidden
source_modules =
    synth
forbidden_modules =
    mpesa_core
